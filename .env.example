###############################################################################
# Open Agent Platform — environment template
#
#   cp .env.example .env     (or: make env, which also generates the secrets)
#
# Placeholders only. Never commit a real .env — it is in .gitignore.
# Values marked [PROD] must be changed before this stack is exposed to anyone
# other than you on localhost.
###############################################################################

# =============================================================================
# 1. LLM provider — OpenRouter
# =============================================================================
# Get a key at https://openrouter.ai/keys. Without it the API still starts but
# reports "degraded" on /health and serves no agents.
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model ids must exist in https://openrouter.ai/api/v1/models.
OAP_DEFAULT_MODEL=anthropic/claude-sonnet-5.5
OAP_BUILDER_MODEL=anthropic/claude-sonnet-5.5
OAP_ENGINEER_MODEL=anthropic/claude-sonnet-5.5
OAP_MANAGER_MODEL=anthropic/claude-haiku-5.5
OAP_SKILLS_MODEL=anthropic/claude-sonnet-5.5
OAP_SCHEDULER_MODEL=anthropic/claude-haiku-5.5
OAP_DOCS_MODEL=anthropic/claude-sonnet-5.5
OAP_DEV_MODEL=anthropic/claude-sonnet-5.5
OAP_RESEARCHER_MODEL=anthropic/claude-sonnet-5.5
OAP_MODEL_MAX_TOKENS=16384

# =============================================================================
# 2. Embeddings — a separate provider on purpose
# =============================================================================
# Chat and embeddings are configured separately. The default host is OpenAI.
# OpenRouter also serves embeddings. To use the same key as chat:
#   EMBEDDING_API_KEY=
#   EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
#   EMBEDDING_MODEL=openai/text-embedding-3-small
# An empty EMBEDDING_API_KEY is reused from OPENROUTER_API_KEY only when the
# base URL contains openrouter.ai. Against api.openai.com an empty key leaves
# indexing off: files are still stored, and /health reports the reason.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# Must match the model's output size. Changing it invalidates every existing
# kb_* table — drop and re-index (`make db-shell`, then DROP TABLE ai.kb_*).
#   text-embedding-3-small = 1536, text-embedding-3-large = 3072
EMBEDDING_DIMENSIONS=1536

# =============================================================================
# 3. OAP runtime
# =============================================================================
OAP_ID=oap
OAP_PORT=8000

# [PROD] Bearer token for the OAP API and the /v1 bridge. Open WebUI sends
# it as OPENAI_API_KEYS. `make env` generates a random value. An empty value
# leaves /v1 unauthenticated (logged as a warning) — localhost only.
OS_SECURITY_KEY=CHANGE_ME_GENERATED_BY_MAKE_SETUP

# Anonymous usage reporting. Off by default.
OAP_TELEMETRY=false
# Verbose application logging.
OAP_DEBUG=false
# Serve the MCP endpoint at /mcp.
ENABLE_MCP_SERVER=true

# Optional API key for AgentQL structured web extraction in project-researcher.
AGENTQL_API_KEY=

# Agno cron scheduler poller and durable background execution queue.
ENABLE_SCHEDULER=true
SCHEDULER_POLL_INTERVAL=15
ENABLE_BACKGROUND_QUEUE=true
BACKGROUND_MAX_CONCURRENCY=16
STORE_RUN_EVENTS=true

# =============================================================================
# 4. Workspace file watcher
# =============================================================================
# Watches workspace_files/ and re-indexes changed documents into PgVector.
ENABLE_FILE_WATCHER=true
# Seconds of quiet before a changed file is indexed (editors write in bursts).
WATCHER_DEBOUNCE_SECONDS=2.0
# Largest Open WebUI upload that will be copied into the workspace (bytes).
MAX_STAGED_UPLOAD_BYTES=67108864

# =============================================================================
# 5. OpenTelemetry → Arize Phoenix
# =============================================================================
OTEL_ENABLED=true
OTEL_SERVICE_NAME=oap-api
# [PROD] Set to "production" so traces are separable by environment.
OTEL_ENVIRONMENT=development
# BASE collector URL. The app appends /v1/traces itself, which is what the
# OpenTelemetry spec says this variable means. Do not include the path here.
OTEL_EXPORTER_OTLP_ENDPOINT=http://oap-otel:6006
# Compose copies OPENROUTER_API_KEY and OPENROUTER_BASE_URL onto the Phoenix
# container as OPENAI_API_KEY and OPENAI_BASE_URL, so the Phoenix assistant
# uses the same provider. No second key is required.
# Comma-separated k=v pairs, e.g. for a hosted collector:
#   OTEL_EXPORTER_OTLP_HEADERS=api_key=...,space_id=...
OTEL_EXPORTER_OTLP_HEADERS=
# Host port for the Phoenix UI (bound to 127.0.0.1).
OTEL_UI_PORT=6006

# =============================================================================
# 6. PostgreSQL + pgvector
# =============================================================================
DB_USER=ai
# [PROD] `make env` generates a random password. These credentials are baked
# into the pgdata volume on first start — see the README before changing them
# on an existing volume.
DB_PASS=CHANGE_ME_GENERATED_BY_MAKE_SETUP
DB_NAME=oap
# Host port for psql access, published on 127.0.0.1 in development only.
DB_PORT=5432
# DATABASE_URL is assembled from the parts above by docker-compose.yml.
# Only set it directly when pointing the API at an external database:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# =============================================================================
# 7. Open WebUI
# =============================================================================
OPEN_WEBUI_PORT=3000
# [PROD] Signs session cookies. Rotating it logs everyone out.
WEBUI_SECRET_KEY=CHANGE_ME_GENERATED_BY_MAKE_SETUP
WEBUI_NAME=Open Agent Platform
# How Open WebUI reaches the bridge, over the compose network.
OPENAI_API_BASE_URLS=http://oap-api:8000/v1
# Model selected for new chats. Use "oap" (the coordinator team) or an agent
# id. With the manifold Pipe installed the ids are prefixed: oap.oap
DEFAULT_MODELS=oap
# Cheap model used for Open WebUI's title/tag generation.
TASK_MODEL_EXTERNAL=platform-manager

# =============================================================================
# 8. Production only
# =============================================================================
# [PROD] Public HTTPS URL your reverse proxy serves. Required by `make prod-up`.
# PUBLIC_BASE_URL=https://agents.example.com
# [PROD] Uvicorn worker processes for the API container.
# UVICORN_WORKERS=2
